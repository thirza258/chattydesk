<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3592604467898331"
     crossorigin="anonymous"></script>
    <meta name="monetag" content="a5692aee6f7c7b3308d722bdad7c1946" />
    <!-- Required by the web build: without it a phone renders the landing page
         at desktop width and scales it down. Harmless in the desktop app. -->
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://cdn.paddle.com https://sandbox-api.paddle.com https://api.paddle.com https://pagead2.googlesyndication.com https://*.googlesyndication.com https://*.google.com https://bauval.org https://*.bauval.org; frame-src 'self' https://*.paddle.com https://sandbox-buy.paddle.com https://buy.paddle.com https://checkout.paddle.com https://googleads.g.doubleclick.net https://*.google.com https://bauval.org https://*.bauval.org; connect-src 'self' https://*.paddle.com https://sandbox-api.paddle.com https://api.paddle.com http://localhost:* ws://localhost:* https://pagead2.googlesyndication.com https://*.google.com https://bauval.org https://*.bauval.org; img-src 'self' data: https://*.paddle.com https://pagead2.googlesyndication.com https://*.google.com https://bauval.org https://*.bauval.org; style-src 'self' 'unsafe-inline';"
    />
<%
  // The SEO block is for the browser build only. In the desktop app it would be
  // dead weight, and a long marketing title would end up in the window title.
  const isBrowser = htmlWebpackPlugin.options.isBrowser;
  const siteURL = (htmlWebpackPlugin.options.siteURL || '').replace(/\/+$/, '');
  const assets = htmlWebpackPlugin.files.publicPath || './';
  const title = 'ChattyDesk — every AI model in one chat window';
  const description =
    'Chat with Claude, GPT, Gemini, Mistral and 400+ more models from one window. Switch model mid-conversation, keep the thread, and reopen anything you asked last week. Runs in the browser or as a desktop app.';
%>
<% if (isBrowser) { %>
    <title><%= title %></title>
    <meta name="description" content="<%= description %>" />
    <meta name="theme-color" content="#020617" />

    <link rel="icon" type="image/svg+xml" href="<%= assets %>icon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="<%= assets %>favicon.png" />
    <link rel="apple-touch-icon" href="<%= assets %>apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ChattyDesk" />
    <meta property="og:title" content="<%= title %>" />
    <meta property="og:description" content="<%= description %>" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="<%= title %>" />
    <meta name="twitter:description" content="<%= description %>" />
<% if (siteURL) { %>
    <!-- Absolute URLs only, so these exist only once SITE_URL is set at build
         time. The canonical also stops a crawler that does not run JavaScript
         from filing /chat and /login as duplicates of the landing page: they all
         serve this same shell. -->
    <link rel="canonical" href="<%= siteURL %>/" />
    <meta property="og:url" content="<%= siteURL %>/" />
    <meta property="og:image" content="<%= siteURL %>/og-image.png" />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta property="og:image:alt" content="The ChattyDesk logo" />
    <meta name="twitter:image" content="<%= siteURL %>/og-image.png" />
<% } %>
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "ChattyDesk",
        "description": "<%= description %>",
        "applicationCategory": "CommunicationApplication",
        "operatingSystem": "Web, Windows, macOS, Linux",
<% if (siteURL) { %>
        "url": "<%= siteURL %>/",
        "image": "<%= siteURL %>/og-image.png",
<% } %>
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD"
        }
      }
    </script>
<% } else { %>
    <title>ChattyDesk</title>
<% } %>
  </head>
  <body>
<% if (isBrowser) { %>
    <!-- The app is client-rendered, so this is all a visitor without
         JavaScript gets. Deliberately one heading and one sentence: anything
         longer would be a second copy of the landing page to keep in step. -->
    <noscript>
      <h1>ChattyDesk</h1>
      <p><%= description %></p>
      <p>ChattyDesk needs JavaScript to run. Enable it, or download the desktop
        app from <a href="https://chattydesk.sourceforge.io/">SourceForge</a>.</p>
    </noscript>
<% } %>
    <div id="root"></div>
      <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3592604467898331"
     crossorigin="anonymous"></script>
        <script async="async" data-cfasync="false" src="https://bauval.org/21/9179af82b37310b591ce091500da6151"></script>
    <div id="container-9179af82b37310b591ce091500da6151"></div>
<!-- Test -->
    <ins class="adsbygoogle"
         style="display:block"
         data-ad-client="ca-pub-3592604467898331"
         data-ad-slot="8935247270"
         data-ad-format="auto"
         data-full-width-responsive="true"></ins>
    <script>
         (adsbygoogle = window.adsbygoogle || []).push({});
    </script>
</body>
</html>
