# nginx config for the Chattydesk web deployment.
#
# The official nginx image runs envsubst over /etc/nginx/templates/*.template
# at container start, replacing ${BACKEND_ORIGIN} only (nginx's own $uri,
# $host, ... are left alone because they are not environment variables).

server {
    listen       80;
    server_name  _;

    root  /usr/share/nginx/html;
    index index.html;

    gzip            on;
    gzip_min_length 1024;
    gzip_types      text/plain text/css application/javascript application/json application/xml image/svg+xml;

    # Filenames are content-hashed, so they can be cached indefinitely.
    location ~* \.(js|css|woff2?|ttf|otf|eot|png|jpg|jpeg|gif|svg|map)$ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Sitemap and robots
    location = /sitemap.xml {
        try_files $uri =404;
        default_type application/xml;
    }

    location = /robots.txt {
        try_files $uri =404;
        default_type text/plain;
    }

    # ...but the document that points at them must not be.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # Reverse proxy to the backend. The browser only ever talks to this
    # origin, so the backend's CORS configuration never comes into play.
    # proxy_pass carries no URI part, which means nginx forwards the original
    # request path unchanged: /api/v1/gpt_handler/ -> backend/api/v1/gpt_handler/
    location /api/ {
        proxy_pass ${BACKEND_ORIGIN};
        proxy_http_version 1.1;
        proxy_set_header Host              $proxy_host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_ssl_server_name on;

        # Model responses are slow; do not cut them off at the default 60s.
        proxy_connect_timeout 30s;
        proxy_send_timeout    300s;
        proxy_read_timeout    300s;
        proxy_buffering       off;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
